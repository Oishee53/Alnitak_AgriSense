# ----- LLM provider (OpenAI) -----
# Get a key from https://platform.openai.com/api-keys
# NOTE: this must be an API key with usable *API* credit (not Codex-CLI-only).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=4096
# Optional: override the base URL (e.g. Azure/OpenAI-compatible gateways).
# OPENAI_BASE_URL=https://api.openai.com/v1

# ----- Weather (Open-Meteo is keyless; no key needed) -----
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search

# ----- Storage -----
DATABASE_URL=sqlite:///./data/agrisense.db
CHROMA_DIR=./data/chroma
KB_DIR=./data/knowledge_base

# ----- bdapps (CaaS Direct Debit + SMS Send) -----
# BDAPPS_SANDBOX=true  -> local simulator, no network (reliable for demos).
# BDAPPS_SANDBOX=false -> real bdapps API. Requires the Pro app's credentials:
#   BDAPPS_APP_ID       = the app id from provisioning (e.g. APP_139290)
#   BDAPPS_APP_PASSWORD = the "API Key" / App Password shown in the console
# Live charges/SMS only reach numbers whitelisted for the app until approval.
BDAPPS_APP_ID=APP_139290
BDAPPS_APP_PASSWORD=
BDAPPS_CAAS_URL=https://developer.bdapps.com/caas/direct/debit
BDAPPS_SMS_URL=https://developer.bdapps.com/sms/send
BDAPPS_SANDBOX=true

# Live relay — needed only when the backend does NOT run on the bdapps host
# whose IP is whitelisted (else you get E1303). Deploy bdapps-relay/*.php on
# that host and set these. Leave blank to call bdapps directly. See
# bdapps-relay/README.md.
BDAPPS_RELAY_URL=
BDAPPS_SMS_RELAY_URL=
BDAPPS_RELAY_SECRET=

# ----- App -----
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
