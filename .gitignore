# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Data / local stores (do NOT commit secrets or large indexes) ----
backend/data/chroma/
backend/data/onnx_models/
backend/data/*.db
backend/data/*.sqlite3
*.log

# Primary source PDFs are large (FRG-2018 alone is ~43 MB) — keep the folder's
# README, which says where to download them and which pages we used.
backend/data/sources/*.pdf

# ---- Redirected pip / npm caches (kept off the full system drive) ----
pip-tmpcache/
pip-tmpnpm-cache/
pip-tmp/

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/.env
npm-debug.log*
yarn-error.log*

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*

# Keep folder structure but ignore contents where noted
!**/.gitkeep

# Local scratch/temp (kept off C:)
.tmp/
